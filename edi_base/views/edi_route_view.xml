<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edi_route_tree" model="ir.ui.view">
        <field name="name">edi.route.tree</field>
        <field name="model">edi.route</field>
        <field name="arch" type="xml">
            <tree string="EDI Route">
                <field name="route_type"/>
            </tree>
        </field>
    </record>

    <record id="view_edi_route_form" model="ir.ui.view">
        <field name="name">edi.route.form</field>
        <field name="model">edi.route</field>
        <field name="arch" type="xml">
            <form string="EDI Route">
                <sheet>
                    <group>
                        <field name="route_type"/>
                        <field name="route_line_ids"/>
                        <field name="session_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_edi_route_view" model="ir.actions.act_window">
        <field name="name">EDI Route</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">edi.route</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>