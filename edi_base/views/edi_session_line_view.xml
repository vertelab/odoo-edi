<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edi_session_line_tree" model="ir.ui.view">
        <field name="name">edi.session.line.tree</field>
        <field name="model">edi.session.line</field>
        <field name="arch" type="xml">
            <tree string="EDI Session Line">
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_edi_session_line_form" model="ir.ui.view">
        <field name="name">edi.session.line.form</field>
        <field name="model">edi.session.line</field>
        <field name="arch" type="xml">
            <form string="EDI Session Line">
                <sheet>
                    <group>
                        <field name="create_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_edi_session_line_view" model="ir.actions.act_window">
        <field name="name">EDI Session Line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">edi.session.line</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>