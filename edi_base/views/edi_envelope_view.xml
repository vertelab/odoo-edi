<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edi_envelope_list" model="ir.ui.view">
        <field name="name">edi.envelope.list</field>
        <field name="model">edi.envelope</field>
        <field name="arch" type="xml">
            <list string="EDI Envelope">
                <field name="name"/>
                <field name="sender"/>
                <field name="receiver"/>
                <field name="type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_edi_envelope_form" model="ir.ui.view">
        <field name="name">edi.envelope.form</field>
        <field name="model">edi.envelope</field>
        <field name="arch" type="xml">
            <form string="EDI Envelope">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="sender" readonly="1"/>
                            <field name="receiver" readonly="1"/>
                            <field name="payload" filename="payload_filename" readonly="1"/>
                            <field name="payload_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="type" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="transport_id" readonly="1"/>
                        </group>
                        <field name="message_ids" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_edi_envelope_view" model="ir.actions.act_window">
        <field name="name">EDI Envelope</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">edi.envelope</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
