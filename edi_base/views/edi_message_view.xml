<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edi_message_list" model="ir.ui.view">
        <field name="name">edi.message.list</field>
        <field name="model">edi.message</field>
        <field name="arch" type="xml">
            <list string="EDI Message">
                <field name="name"/>
                <field name="message_format_id"/>
                <field name="sender"/>
                <field name="receiver"/>
                <field name="envelope_id"/>
            </list>
        </field>
    </record>

    <record id="view_edi_message_form" model="ir.ui.view">
        <field name="name">edi.message.form</field>
        <field name="model">edi.message</field>
        <field name="arch" type="xml">
            <form string="EDI Message">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="message_format_id" readonly="1"/>
                            <field name="consignor" readonly="1"/>
                            <field name="sender" readonly="1"/>
                        </group>
                        <group>
                            <field name="consignee" readonly="1"/>
                            <field name="receiver" readonly="1"/>
                            <field name="payload" filename="payload_filename" readonly="1"/>
                            <field name="payload_filename" invisible="1"/>
                            <field name="envelope_id" readonly="1"/>
                            <field name="res_id" invisible="1" force_save="1"/>
                            <field name="res_model" invisible="1" force_save="1"/>
                            <field name="reference" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_edi_message_view" model="ir.actions.act_window">
        <field name="name">EDI Message</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">edi.message</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
