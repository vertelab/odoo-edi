<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edi_route_line_list" model="ir.ui.view">
        <field name="name">edi.route.line.list</field>
        <field name="model">edi.route.line</field>
        <field name="arch" type="xml">
            <list string="EDI Route Line">
                <field name="message_format_id"/>
                <field name="transport_id"/>
                <field name="domain"/>
                <field name="route_id"/>
            </list>
        </field>
    </record>

    <record id="view_edi_route_line_form" model="ir.ui.view">
        <field name="name">edi.route.line.form</field>
        <field name="model">edi.route.line</field>
        <field name="arch" type="xml">
            <form string="EDI Route Line">
                <sheet>
                    <group>
                        <field name="message_format_id"/>
                        <field name="transport_id"/>
                        <field name="domain"/>
                        <field name="route_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_edi_route_line_view" model="ir.actions.act_window">
        <field name="name">EDI Route Line</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">edi.route.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
