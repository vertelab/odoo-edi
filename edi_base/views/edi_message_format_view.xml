<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edi_message_format_list" model="ir.ui.view">
        <field name="name">edi.message.format.list</field>
        <field name="model">edi.message.format</field>
        <field name="arch" type="xml">
            <list string="EDI Message Format">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_edi_message_format_form" model="ir.ui.view">
        <field name="name">edi.message.format.form</field>
        <field name="model">edi.message.format</field>
        <field name="arch" type="xml">
            <form string="EDI Message Format">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_edi_message_format_view" model="ir.actions.act_window">
        <field name="name">EDI Message Format</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">edi.message.format</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
