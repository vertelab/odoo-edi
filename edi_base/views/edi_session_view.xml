<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_edi_session_list" model="ir.ui.view">
        <field name="name">edi.session.list</field>
        <field name="model">edi.session</field>
        <field name="arch" type="xml">
            <list string="EDI Session">
                <field name="name"/>
                <field name="route_type"/>
                <field name="route_id"/>
                <field name="sessions_line_ids"/>
            </list>
        </field>
    </record>

    <record id="view_edi_session_form" model="ir.ui.view">
        <field name="name">edi.session.form</field>
        <field name="model">edi.session</field>
        <field name="arch" type="xml">
            <form string="EDI Session">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="sessions_line_ids" readonly="1"/>
                        <field name="route_id" readonly="1"/>
                        <field name="route_type" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_open_edi_session_view" model="ir.actions.act_window">
        <field name="name">EDI Session</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">edi.session</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
