<odoo>
    <record id="view_file_envelope_upload_wizard" model="ir.ui.view">
        <field name="name">file.upload.envelope.wizard.form</field>
        <field name="model">file.upload.envelope.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload File">
                <group>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button string="Unpack" type="object" name="unpack" class="oe_highlight"/>
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_file_upload_envelope_wizard" model="ir.actions.act_window">
      <field name="name">Upload Envelope File</field>
      <field name="res_model">file.upload.envelope.wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
      <field name="view_id" ref="view_file_envelope_upload_wizard"/>
    </record>

    <menuitem id="ed_upload_wizard" name="Upload Edi Envelope" action="action_file_upload_envelope_wizard" parent="edi_base.edi_configuration"/>


</odoo>
