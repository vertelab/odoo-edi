<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- EDI Envelope form view extension -->
        <record id="view_account_move_form_extended" model="ir.ui.view">
            <field name="name">account.move.form.edifact</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <button name="button_draft" position="after">
                    <button name="action_pack_edi" string="Send EDI Message" class="oe_highlight" type="object"/>
                </button>
            </field>
        </record>

    </data>
</odoo>