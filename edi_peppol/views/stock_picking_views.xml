<?xml version="1.0"?>
<odoo>
    <record id="view_picking_form_inherited" model="ir.ui.view">
        <field name="name">stock.picking.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_edi_messages" class="oe_stat_button" icon="fa-comment" invisible="edi_message_count == 0">
                    <field name="edi_message_count" widget="statinfo" string="EDI Messages"/>
                    <field name="edi_message_ids" invisible="1"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>