<?xml version="1.0"?>
<odoo>
    <record id="view_purchase_order_form_inherited" model="ir.ui.view">
        <field name="name">purchase.order.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_view_edi_messages" class="oe_stat_button" icon="fa-comment" invisible="edi_message_count == 0">
                    <field name="edi_message_count" widget="statinfo" string="EDI Messages"/>
                    <field name="edi_message_ids" invisible="1"/>
                </button>
            </xpath>

            <field name="state" position="after">
                <field name="show_send_peppol_button" invisible="1"/>
            </field>

            <button name="action_create_invoice" position="after">
                <button string="Queue Peppol Order" 
                        class="btn-primary"
                        type="object"
                        name="send_peppol_outgoing_message"
                        invisible="show_send_peppol_button == False"/>
            </button>

            <xpath expr="//page[@name='purchase_delivery_invoice']" position="after">
                <page string="PEPPOL" name="peppol_tab">
                    <group>
                        <group>
                            <field name="issue_date"/>
                        </group>
                        <group>
                            <field name="validity_period"/>
                            <field name="customer_partner_id"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
                <field name="edi_state" column_invisible="not parent.edi_message_ids"/>
            </xpath>

            <xpath expr="//field[@name='order_line']/list" position="attributes">
                <attribute name="decoration-info">edi_state == 'changed'</attribute>
                <attribute name="decoration-success">edi_state == 'accepted'</attribute>
                <attribute name="decoration-danger">edi_state == 'rejected'</attribute>
            </xpath>
        </field>
    </record>
</odoo>